      "source": [
        "select features and target"
      ],
      "metadata": {
        "id": "mHwXT72iRTA0"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "target = 'total_direct_emissions'\n",
        "leak_cols = ['CO2_emissions', 'CH4_emissions', 'N2O_emissions', 'total_major_ghg', 'CH4_share_pct', 'CO2_share_pct', 'emission_category']\n",
        "features = [\n",
        "    col\n",
        "    for col in df_encoded.columns\n",
        "    if col not in ['year', 'facility_name', 'city', target] + leak_cols\n",
        "]#target and features"
      ],
      "metadata": {
        "id": "k5CN792aPHIb"
      },
      "execution_count": 81,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "see outliers"
      ],
      "metadata": {
        "id": "EIzl1hfSxFEy"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "Q1 = df['total_direct_emissions'].quantile(0.25)\n",
        "Q3 = df['total_direct_emissions'].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "lower_bound = Q1 - 1.5 * IQR\n",
        "upper_bound = Q3 + 1.5 * IQR\n",
        "outliers = df[(df['total_direct_emissions'] < lower_bound) | (df['total_direct_emissions'] > upper_bound)]\n",
        "\n",
        "print(f\"Lower Bound: {lower_bound:,.2f}\")\n",
        "print(f\"Upper Bound: {upper_bound:,.2f}\")\n",
        "print(f\"Number of Outliers: {len(outliers)}\")\n",
        "print(f\"Percentage of Outliers: {(len(outliers) / len(df)) * 100:.2f}%\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
