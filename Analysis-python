import pandas as pd
import plotly.express as px

df=pd.read_excel(r"/content/APC.xlsx")

yearly = df.groupby('year')['total_direct_emissions'].sum().reset_index()
fig = px.line(
    yearly,
    x='year',
    y='total_direct_emissions',
    markers=True,
    title='Total Emissions Over Time')
fig.show()

df = df.groupby('year')['total_direct_emissions'].sum().reset_index()
df = df.sort_values(by='year', ascending=True)
df['year_str'] = df['year'].astype(str)

fig = px.pie(
    df,
    names='year_str',
    values='total_direct_emissions',
    title='Emissions Percentage by Year',
    template='plotly_white',
    category_orders={'year_str': df['year_str'].tolist()}
)
fig.update_traces(textinfo='percent+label')
fig.update_layout(width=700, height=500)
fig.show()